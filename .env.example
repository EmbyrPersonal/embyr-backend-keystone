# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key (NEVER the anon key) — bypasses RLS, used only server-side.
# Found in Supabase dashboard: Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/public key — used for the signup/login calls that go through Supabase Auth.
SUPABASE_ANON_KEY=

# Port the Express server listens on locally. Render sets its own PORT env var in production.
PORT=4000

# Comma-separated list of origins allowed to call this API (the Atlas app doesn't need this,
# but useful if a web-based dashboard is added later). Leave blank to allow all in dev.
ALLOWED_ORIGINS=
